; Run control
integrator               = {{integrator}}
;tinit                    = 0
dt                       = {{dt}}
comm-mode                = Linear
nsteps                   = {{nsteps}}
nstcomm                  = 100 ; (used to set equal to output_control in older simulations)
nstxout                  = {{output_control}} ; I had 50000 for long sims, default is arround 1000
nstvout                  = {{output_control}}
nstcalcenergy            = {{nstcalcenergy}} ; this is the exact sampling that goes into edr file, need to be more precise here: 100 default
nstfout                  = 0
nstlog                   = {{output_control}}
nstenergy                = {{output_control}}
nstxout-compressed       = 0
; Neighborsearching and short-range nonbonded interactions
cutoff-scheme            = verlet
nstlist                  = 10; nstlist = 10 is default; nstlist = 0 means no cutoff
pbc                      = xyz
rlist                    = {{rcoulomb}}
; Electrostatics
coulombtype              = {{coulombtype}}
coulomb-modifier         = {{coulomb_modifier}}
rcoulomb                 = {{rcoulomb}}
rcoulomb-switch          = {{rcoulomb_switch}}
; van der Waals
vdwtype                  = {{vdwtype}}
vdw-modifier             = {{vdw_modifier}}
rvdw                     = {{rvdw}}
rvdw-switch              = {{rvdw_switch}}
DispCorr                 = {{DispCorr}};no
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-04
ewald-rtol-lj		     = 1e-03
lj-pme-comb-rule	     = lorentz-berthelot
ewald-geometry           = 3d 
epsilon-surface          = 0

; Temperature coupling
tcoupl                   = {{tcoupl}}
tc-grps                  = system
tau-t                    = 0.2
ref-t                    = {{ref_t}} ; 298.15


free_energy              = yes
init_lambda_state        = {{current_lambda}}
delta-lambda             = 0
calc-lambda-neighbors    = -1       ;all states
couple-moltype           = MOL1 ; {{molecule_of_interest}} ; <-- MOL1 as a bandate fix.
couple-lambda0           = vdw-q      ; van der Waals+electrostatics
couple-lambda1           = none     ; turn off everything,
couple-intramol          = no
nstdhdl                  = {{nstdhdl}} ; 10 in tutorial
sc-sigma                 = 0.3
sc-power                 = 2
sc-coul                  = yes
sc-alpha                 = 0.5

; init_lambda_state      = {{lambda_index}}
bonded-lambdas           = {{bonded_lambdas}}
coul-lambdas             = {{coul_lambdas}}
vdw-lambdas              = {{vdw_lambdas}}

